    "class Student:\n",
    "   def __init__(self,name,age,course,group):\n",
    "     self.name = name\n",
    "     self.age = age\n",
    "     self.course = course\n",
    "     self.group = group\n",
    "s1=Student(\"sweety\",\"19\",\"B.Sc\",\"MStDs\")\n",
    "print(s1.name)\n",
    "print(s1.age)\n",
    "print(s1.course)\n",
    "print(s1.group)"
   ]
  },
